{{!
    @template mod_aianatomy/editor

    Teacher editor shell. The editor UI is built by amd/src/editor.js from the JSON config.

    Example context (json):
    {
        "uniqid": "aa-editor-1",
        "name": "Bones of the hand",
        "config": "{}"
    }
}}
<div id="{{uniqid}}" class="aa-editor ax-editor" data-config="{{config}}">
    <div class="ax-ed-loading">{{#str}} loading, mod_aianatomy {{/str}}</div>
</div>
