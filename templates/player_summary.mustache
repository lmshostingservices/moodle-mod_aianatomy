{{!
    @template mod_aianatomy/player_summary

    Results screen shown when a Practice or Test attempt is finished.

    Context variables required for this template:
    * ring - Circumference of the score ring.
    * verdict - Passed or not yet (pass, icon, text), or false.
    * title, sub - Result message and "x of y correct".
    * stats - Figures (icon, label, value).
    * leaderboard - Top scores (icon, heading, rows: rank, name, me, percent, time), or false.
    * review, again, back - Button labels and icons; againdisabled when no attempts are left.

    Example context (json):
    {
        "ring": 326.73,
        "verdict": {"pass": true, "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>", "text": "Passed"},
        "title": "Great job!",
        "sub": "12 of 14 correct",
        "stats": [{"icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>", "label": "Time", "value": "1:32"}],
        "leaderboard": {
            "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>",
            "heading": "Leaderboard",
            "rows": [{"rank": 1, "name": "Sam K. (you)", "me": true, "percent": 92.9, "time": "1:32"}]
        },
        "review": {"label": "Review answers", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"},
        "again": {"label": "Try again", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"},
        "againdisabled": false,
        "back": {"label": "Back to menu", "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"></svg>"}
    }
}}
<div class="aa-summary">
    <div class="aa-summary-ring">
        <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="aa-ring-bg" cx="60" cy="60" r="52"/>
            <circle class="aa-ring-fg" cx="60" cy="60" r="52" stroke-dasharray="{{ring}}" stroke-dashoffset="{{ring}}"/>
        </svg>
        <div class="aa-ring-label"><strong data-count>0</strong><span>%</span></div>
    </div>
    {{#verdict}}
    <div class="aa-verdict {{#pass}}is-pass{{/pass}}{{^pass}}is-fail{{/pass}}">{{{icon}}}<span>{{text}}</span></div>
    {{/verdict}}
    <h3 class="aa-summary-title">{{title}}</h3>
    <p class="aa-summary-sub">{{sub}}</p>
    <div class="aa-summary-stats">
        {{#stats}}
        <div class="aa-sstat">{{{icon}}}<span>{{label}}</span><strong>{{value}}</strong></div>
        {{/stats}}
    </div>
    {{#leaderboard}}
    <div class="aa-leaderboard">
        <h4>{{{icon}}}{{heading}}</h4>
        <ol>
            {{#rows}}
            <li class="{{#me}}is-me{{/me}}"><span class="aa-lb-rank">{{rank}}</span><span class="aa-lb-name">{{name}}</span><span class="aa-lb-pct">{{percent}}%</span><span class="aa-lb-time">{{time}}</span></li>
            {{/rows}}
        </ol>
    </div>
    {{/leaderboard}}
    <div class="aa-summary-actions">
        <button type="button" class="aa-btn aa-btn-ghost" data-action="review">{{{review.icon}}}<span>{{review.label}}</span></button>
        <button type="button" class="aa-btn aa-btn-ghost" data-action="again"{{#againdisabled}} disabled{{/againdisabled}}>{{{again.icon}}}<span>{{again.label}}</span></button>
        <button type="button" class="aa-btn aa-btn-primary" data-action="back"><span>{{back.label}}</span>{{{back.icon}}}</button>
    </div>
</div>
