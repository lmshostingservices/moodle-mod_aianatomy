{{!
    @template mod_aianatomy/report_bar

    A percentage bar used in the teacher report.

    Context variables required for this template:
    * pct - Bar width, 0 to 100.
    * label - Rounded percentage shown next to the bar.
    * class - Extra bar class: empty, " is-mid" or " is-bad".

    Example context (json):
    {
        "pct": 62.5,
        "label": 63,
        "class": " is-mid"
    }
}}
<div class="aa-bar-row"><div class="aa-bar{{class}}"><span style="width: {{pct}}%"></span></div><b>{{label}}%</b></div>
